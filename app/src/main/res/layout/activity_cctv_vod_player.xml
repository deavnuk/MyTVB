<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <android.webkit.WebView
        android:id="@+id/web_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="@dimen/px80"
        android:layout_height="@dimen/px80"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/px140"
        android:text="@string/cctv_vod_stream_loading"
        android:textColor="@android:color/white"
        android:textSize="@dimen/px26"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="@dimen/px30"
        android:visibility="gone" />

    <!-- 暂停指示：暂停时右下角显示大暂停图标，与普通视频播放器同款同位置。
         放在控制条之前（z 序更低），即使缩放导致边缘重叠也不会挡住控制条按钮。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_pause_indicator"
        android:layout_width="@dimen/px135"
        android:layout_height="@dimen/px135"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/px90"
        android:layout_marginBottom="@dimen/px169"
        android:alpha="0.9"
        android:contentDescription="@string/pause"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_pause_new" />

    <!-- 我们自己的控制条：官方播放器只认鼠标/触摸，遥控器操作不了，
         所以播放控制与菜单由这一层承担，再通过 JS 驱动官方播放器。 -->
    <LinearLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="@dimen/px40"
        android:paddingTop="@dimen/px20"
        android:paddingEnd="@dimen/px40"
        android:paddingBottom="@dimen/px25">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/px30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_play"
                android:layout_width="@dimen/px70"
                android:layout_height="@dimen/px70"
                android:background="@drawable/tab_item_round_background"
                android:clickable="true"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:padding="@dimen/px16"
                app:srcCompat="@drawable/ic_pause"
                app:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px20"
                android:textColor="@android:color/white"
                android:textSize="@dimen/px24" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px20"
                android:layout_marginEnd="@dimen/px20"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:max="100"
                android:paddingTop="@dimen/px10"
                android:paddingBottom="@dimen/px10" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/px24" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/button_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px30"
                android:background="@drawable/tab_item_round_background"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/px45"
                android:paddingTop="@dimen/px20"
                android:paddingEnd="@dimen/px45"
                android:paddingBottom="@dimen/px20"
                android:text="@string/cctv_quality"
                android:textColor="@android:color/white"
                android:textSize="@dimen/px26" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/button_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/px20"
                android:background="@drawable/tab_item_round_background"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/px45"
                android:paddingTop="@dimen/px20"
                android:paddingEnd="@dimen/px45"
                android:paddingBottom="@dimen/px20"
                android:text="@string/choose_episode"
                android:textColor="@android:color/white"
                android:textSize="@dimen/px26" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左上角返回按钮：底部控制条在下方，退出播放页的可见入口单独悬浮在左上，
         与控制条同步显隐（遥控器上从画质/选集继续上移可达）。 -->
    <com.mytvb.feature.player.view.PlayerControlButton
        android:id="@+id/button_back"
        android:layout_width="@dimen/px80"
        android:layout_height="@dimen/px80"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/px40"
        android:layout_marginTop="@dimen/px35"
        android:background="@drawable/cell_background"
        android:clickable="true"
        android:contentDescription="@string/back"
        android:focusable="true"
        android:padding="@dimen/px18"
        app:srcCompat="@drawable/ic_back" />

</FrameLayout>
