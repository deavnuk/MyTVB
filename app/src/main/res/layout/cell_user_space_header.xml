<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
        android:id="@+id/user_space_top"
        layout="@layout/cell_user_space_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/header_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="user_space_top" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvVideoCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px20"
        android:layout_marginEnd="@dimen/px40"
        android:layout_marginBottom="@dimen/px8"
        android:textColor="?attr/tabBarNormal"
        android:textSize="@dimen/px28"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/buttonOrder"
        app:layout_constraintTop_toBottomOf="@+id/header_bottom_barrier"
        tools:text="投稿视频 0" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/buttonOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px35"
        android:background="@drawable/bg_user_space_order_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/px16"
        android:paddingTop="@dimen/px6"
        android:paddingEnd="@dimen/px16"
        android:paddingBottom="@dimen/px6"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tvVideoCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvVideoCount"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/px28"
            android:layout_height="@dimen/px28"
            app:srcCompat="@drawable/ic_order"
            app:tint="@color/white" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px8"
            android:text="@string/model_search_order_pub_date"
            android:textColor="@color/white"
            android:textSize="@dimen/px24" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/px18"
            android:layout_height="@dimen/px18"
            android:layout_marginStart="@dimen/px6"
            app:srcCompat="@drawable/arrow_down"
            app:tint="@color/white" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 列表 tab：视频/直播回放/系列/合集（与弹窗同款样式） -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabFilter"
        android:layout_width="0dp"
        android:layout_height="@dimen/px80"
        android:layout_marginStart="@dimen/px35"
        android:layout_marginTop="@dimen/px4"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVideoCount"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/underline"
        app:tabIndicatorColor="?attr/colorAccent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/px10"
        app:tabMode="scrollable"
        app:tabMaxWidth="0dp"
        app:tabPaddingStart="@dimen/px20"
        app:tabPaddingEnd="@dimen/px20"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="?android:attr/textColorPrimary"
        app:tabTextAppearance="@style/OwnerDetailTabText"
        app:tabSelectedTextAppearance="@style/OwnerDetailTabText"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
