<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/px40"
    android:paddingTop="@dimen/px35"
    android:paddingEnd="@dimen/px40"
    android:paddingBottom="@dimen/px30">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/px38"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_actors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px12"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/px26" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/px2"
        android:layout_marginTop="@dimen/px20"
        android:background="#66666666" />

    <com.mytvb.ui.widget.NonFocusableScrollView
        android:id="@+id/scroll_brief"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px20"
        android:clipToPadding="false"
        android:paddingEnd="@dimen/px10">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/px8"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/px30" />
    </com.mytvb.ui.widget.NonFocusableScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/button_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/px20"
        android:background="@drawable/bg_owner_dialog_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/px35"
        android:paddingTop="@dimen/px12"
        android:paddingEnd="@dimen/px35"
        android:paddingBottom="@dimen/px12"
        android:text="@string/close"
        android:textColor="@color/textColor"
        android:textSize="@dimen/px28" />

</LinearLayout>
