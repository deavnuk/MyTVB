<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/px35"
    android:paddingTop="@dimen/px30"
    android:paddingEnd="@dimen/px35"
    android:paddingBottom="@dimen/px30">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_cover"
            android:layout_width="@dimen/px225"
            android:layout_height="@dimen/px300"
            android:scaleType="centerCrop"
            android:src="@drawable/default_video" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/px300"
            android:layout_marginStart="@dimen/px30"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="@dimen/px38"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/button_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/px20"
                    android:background="@drawable/bg_owner_dialog_outline_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/px20"
                    android:paddingTop="@dimen/px4"
                    android:paddingEnd="@dimen/px20"
                    android:paddingBottom="@dimen/px4"
                    android:text="@string/cctv_vod_favorite"
                    android:textColor="@color/textColor"
                    android:textSize="@dimen/px24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/px26" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/button_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/px20"
                    android:background="@drawable/bg_owner_dialog_outline_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/px20"
                    android:paddingTop="@dimen/px4"
                    android:paddingEnd="@dimen/px20"
                    android:paddingBottom="@dimen/px4"
                    android:text="@string/cctv_vod_detail_action"
                    android:textColor="@color/textColor"
                    android:textSize="@dimen/px24" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_actors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px12"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/px26" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_brief"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/px16"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/px6"
                android:maxLines="5"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/px30" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/px2"
        android:layout_marginTop="@dimen/px25"
        android:background="#66666666" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_episode_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px20"
        android:text="@string/choose_episode"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/px30"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_episode_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/cctv_vod_episodes_loading"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/px26" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/px15"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:paddingBottom="@dimen/px20"
        android:visibility="gone" />

</LinearLayout>
