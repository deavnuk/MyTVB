<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/px35"
    android:paddingTop="@dimen/px30"
    android:paddingEnd="@dimen/px35"
    android:paddingBottom="@dimen/px25">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cctv_vod_search_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/px32"
        android:textStyle="bold" />

    <!-- 关键词输入：系统输入法（中文）与右侧自绘键盘（拼音）双通道，文本变化即过滤 -->
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px15"
        android:hint="@string/cctv_vod_search_query_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/colorAccent"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="@dimen/px30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px12"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_owner_dialog_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/px30"
            android:paddingTop="@dimen/px8"
            android:paddingEnd="@dimen/px30"
            android:paddingBottom="@dimen/px8"
            android:text="@string/cctv_vod_search_confirm"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/px26" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px15"
            android:background="@drawable/bg_owner_dialog_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/px30"
            android:paddingTop="@dimen/px8"
            android:paddingEnd="@dimen/px30"
            android:paddingBottom="@dimen/px8"
            android:text="@string/cctv_vod_search_clear"
            android:textColor="@color/textColor"
            android:textSize="@dimen/px26" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_ime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px15"
            android:background="@drawable/bg_owner_dialog_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/px30"
            android:paddingTop="@dimen/px8"
            android:paddingEnd="@dimen/px30"
            android:paddingBottom="@dimen/px8"
            android:text="@string/cctv_vod_search_ime"
            android:textColor="@color/textColor"
            android:textSize="@dimen/px26" />
    </LinearLayout>

    <com.mytvb.feature.search.view.KeyboardView
        android:id="@+id/view_keyboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/px15"
        android:layout_weight="1"
        android:clipChildren="false" />

</LinearLayout>
