<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mytvb.core.ui.image.AvatarBadgeView
        android:id="@+id/image_avatar"
        android:focusable="false"
        android:layout_width="@dimen/px80"
        android:layout_height="@dimen/px80"
        android:layout_marginLeft="@dimen/px35"
        android:layout_marginTop="@dimen/px30"
        android:layout_marginStart="@dimen/px35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/default_avatar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/px30"
        android:textStyle="bold"
        android:textColor="@color/textColor"
        android:id="@+id/text_name"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_episode"
        android:paddingStart="@dimen/px25"
        android:paddingEnd="@dimen/px25"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintStart_toEndOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/button_follow"
        android:background="@drawable/bg_owner_dialog_outline_button"
        android:paddingLeft="@dimen/px30"
        android:paddingTop="@dimen/px15"
        android:paddingRight="@dimen/px30"
        android:paddingBottom="@dimen/px15"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/px30"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        android:layout_marginEnd="@dimen/px30"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_avatar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_follow"
            android:layout_width="@dimen/px35"
            android:layout_height="@dimen/px35"
            app:srcCompat="@drawable/ic_plus"
            app:tint="@color/white"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px30"
            android:textColor="@color/white"
            android:id="@+id/text_follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/px10"
            android:text="@string/follow"
            android:layout_marginStart="@dimen/px10"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/px80"
        android:layout_marginTop="@dimen/px15"
        android:layout_marginStart="@dimen/px35"
        android:layout_marginEnd="@dimen/px35"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/underline"
        app:tabIndicatorColor="?attr/colorAccent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/px10"
        app:tabMode="scrollable"
        app:tabMaxWidth="0dp"
        app:tabPaddingStart="@dimen/px20"
        app:tabPaddingEnd="@dimen/px20"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="?android:attr/textColorPrimary"
        app:tabTextAppearance="@style/OwnerDetailTabText"
        app:tabSelectedTextAppearance="@style/OwnerDetailTabText"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/buttonOrder"
        android:background="@drawable/bg_owner_dialog_outline_button"
        android:paddingLeft="@dimen/px14"
        android:paddingRight="@dimen/px14"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/px20"
        app:layout_constraintBottom_toBottomOf="@+id/button_follow"
        app:layout_constraintEnd_toStartOf="@+id/button_follow"
        app:layout_constraintTop_toTopOf="@+id/button_follow">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/px32"
            android:layout_height="@dimen/px32"
            app:srcCompat="@drawable/ic_order"
            app:tint="@color/white"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px28"
            android:textColor="@color/white"
            android:id="@+id/textOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/px8"
            android:text="@string/model_search_order_pub_date"
            android:layout_marginStart="@dimen/px8"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/px20"
            android:layout_height="@dimen/px20"
            android:layout_marginStart="@dimen/px6"
            app:srcCompat="@drawable/arrow_down"
            app:tint="@color/white"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="@dimen/px50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    <!-- 空 tab 提示：该 tab 首屏加载完成且无内容时显示，纯展示不可聚焦 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/px36"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/px4"
        android:layout_marginStart="@dimen/px35"
        android:layout_marginEnd="@dimen/px35"
        android:layout_marginTop="@dimen/px20"
        android:background="#66666666"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_avatar"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px80"
        android:layout_marginBottom="@dimen/px80"
        android:layout_marginStart="@dimen/px80"
        android:layout_marginEnd="@dimen/px80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
