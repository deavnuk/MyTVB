<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mytvb.feature.player.view.MyPlayerView
        android:id="@+id/playerView"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <!-- 同时观看人数（左下角浮层，控制层展开时隐藏；贴近常驻细进度条上方） -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/view_online_watching"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/px30"
        android:layout_marginBottom="@dimen/px7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/image_online_watching"
            android:layout_width="@dimen/px32"
            android:layout_height="@dimen/px32"
            android:src="@drawable/ic_player_watching"
            android:tint="@color/grey"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/text_online_watching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/px10"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/grey"
            android:textSize="@dimen/px26"
            android:importantForAccessibility="no"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <!-- 抖音模式视频切换过渡遮罩 -->
    <ImageView
        android:id="@+id/image_douyin_transition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="start"
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/view_next"
        android:background="@drawable/transparent_black_bg"
        android:paddingTop="@dimen/px20"
        android:paddingBottom="@dimen/px20"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/px180"
        android:paddingStart="@dimen/px20"
        android:paddingEnd="@dimen/px20">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px35"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:shadowColor="@color/systemBackgroundColor"
            android:shadowRadius="4"
            android:layout_marginStart="@dimen/px17"/>
        <FrameLayout
            android:layout_width="@dimen/px350"
            android:layout_height="@dimen/px197"
            android:layout_marginLeft="@dimen/px15"
            android:layout_marginTop="@dimen/px20"
            android:layout_marginRight="@dimen/px15"
            android:layout_marginStart="@dimen/px15"
            android:layout_marginEnd="@dimen/px15">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageView_next"
                android:background="@drawable/default_video"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <com.mytvb.feature.player.view.CountdownView
                android:id="@+id/countdown_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px30"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/text_next"
            android:layout_width="@dimen/px350"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px15"
            android:text="TitleTitleTitleTitleTitleTitleTitleTitleTitleTitleTitleTitleTitleTitle"
            android:maxLines="2"
            android:shadowColor="@color/systemBackgroundColor"
            android:shadowRadius="4"
            android:layout_marginStart="@dimen/px17"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/dim_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/view_related"
        android:visibility="gone"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/px35"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/title_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_"
            android:shadowColor="@color/systemBackgroundColor"
            android:shadowRadius="4"
            android:layout_marginStart="@dimen/px30"
            android:layout_marginTop="@dimen/px20"
            android:layout_marginBottom="@dimen/px15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_close_related"
            android:background="@drawable/cell_background"
            android:padding="@dimen/px8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/px60"
            android:layout_height="@dimen/px60"
            android:layout_marginRight="@dimen/px30"
            android:layout_marginEnd="@dimen/px30"
            android:layout_marginTop="@dimen/px10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRelated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/related_panel_bg"
            android:padding="@dimen/px15"
            android:paddingBottom="@dimen/px40"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_more"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/px45"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:shadowColor="@color/black"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="0"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/text_subtitle"
        android:background="@drawable/subtitle_bg"
        android:paddingLeft="@dimen/px30"
        android:paddingTop="@dimen/px10"
        android:paddingRight="@dimen/px30"
        android:paddingBottom="@dimen/px10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/px60"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"/>
    <com.mytvb.feature.player.sponsor.SponsorProgressMarkerView
        android:layout_gravity="bottom"
        android:id="@+id/bottom_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/px4"
        android:visibility="gone"/>
    <!-- 控制栏隐藏时常驻的章节分段进度条（官方 TV 版形态）：按章节比例分段，
         触摸点击某段跳该章起点；View 全高(px60)均为触摸命中区，可见条只占底部 px7；
         章节开关开启且有章节时显示并抑制细进度条 -->
    <com.mytvb.feature.player.viewpoint.ChapterSegmentBarView
        android:layout_gravity="bottom"
        android:id="@+id/chapter_segment_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/px60"
        android:visibility="gone"/>
    <!-- 播放结束推荐页：连播倒计时期间按返回键=取消连播并展示本页
         （黑底+重播按钮+相关推荐网格，对标 YouTube TV 播完页形态）。
         用应用内覆盖层而非 Dialog，规避电视端弹窗裁高问题 -->
    <FrameLayout
        android:id="@+id/view_play_end_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/px50"
            android:paddingTop="@dimen/px30"
            android:paddingEnd="@dimen/px50"
            android:paddingBottom="@dimen/px25">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/button_replay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/cell_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/px40"
                android:paddingTop="@dimen/px15"
                android:paddingEnd="@dimen/px40"
                android:paddingBottom="@dimen/px15">
                <ImageView
                    android:layout_width="@dimen/px40"
                    android:layout_height="@dimen/px40"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_refresh"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/px15"
                    android:text="@string/play_end_replay"
                    android:textColor="@color/white"
                    android:textSize="@dimen/px32"
                    android:textStyle="bold"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_play_end_related"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/px25"
                android:text="@string/play_end_related_title"
                android:textColor="@color/white"
                android:textSize="@dimen/px35"
                android:textStyle="bold"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPlayEnd"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/px15"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="@dimen/px10"
                android:paddingBottom="@dimen/px20"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</FrameLayout>
